# Database
POSTGRES_DB=smarthome_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USE_TLS=True
MQTT_CA_CERTS=/app/certs/ca.crt

# Django App
MQTT_CLIENT_CERT=/app/certs/backend.crt
MQTT_CLIENT_KEY=/app/certs/backend.key
DEBUG=False
SECRET_KEY=uuuu_secret
ALLOWED_HOSTS=api,localhost,127.0.0.1,172.17.0.1,172.18.0.1,172.19.0.1,172.20.0.1,172.21.0.1,172.22.0.1,*
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
USE_X_FORWARDED_PROTO=False

# Simulator
UPDATE_INTERVAL=5
BATTERY_DRAIN_INTERVAL=60
MQTT_GATEWAY_CERT=/app/certs/gateway.crt
MQTT_GATEWAY_KEY=/app/certs/gateway.key

# Frontend
API_URL=http://api:8000
